# Copy this file to .env and fill in what you need. .env is git-ignored, so secrets stay off GitHub.

# Turns on Smart add, Break down and Plan my day. Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=

# Optional: which Claude model the in-app AI uses
# TASKLINE_AI_MODEL=claude-opus-5-5

# Optional: web app port (default 4100)
# PORT=4100

# Optional: where your data lives. Defaults:
#   macOS:   ~/Library/Application Support/Taskline
#   Windows: %APPDATA%\Taskline
# TASKLINE_DATA_DIR=

# Optional: how many daily backups to keep (default 14)
# TASKLINE_BACKUP_KEEP=14

# Optional: email me if the daily backup fails. Use an app password, not your main password.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# ALERT_EMAIL_TO=
